# Cloudflare Pages joins a header that two matching rules both set, so each Cache-Control path below matches one rule only.
# Report-Only CSP: promote to Content-Security-Policy after the Report-Only run shows no violations on the live site.
# Pages Functions do not receive this file. The site has none.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public files keep their names, so a changed file needs a new name or it stays cached for up to one day.
/ImageSlider/*
  Cache-Control: public, max-age=86400, must-revalidate

# The site routes /initiatives/:id and /resources/:id return index.html, so these rules name file types and subfolders, never the whole folder.
/Initiatives/*.png
  Cache-Control: public, max-age=86400, must-revalidate

/Initiatives/thumbs/*
  Cache-Control: public, max-age=86400, must-revalidate

/KeyHighlights/*
  Cache-Control: public, max-age=86400, must-revalidate

/Recentevents/*
  Cache-Control: public, max-age=86400, must-revalidate

/document_pdfs/*
  Cache-Control: public, max-age=86400, must-revalidate

/hero/*
  Cache-Control: public, max-age=86400, must-revalidate

/resources/data-camp/*
  Cache-Control: public, max-age=86400, must-revalidate

/resources/jan17/*
  Cache-Control: public, max-age=86400, must-revalidate

/resources/reports/*
  Cache-Control: public, max-age=86400, must-revalidate
